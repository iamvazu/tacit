# Admin Credentials for /admin basic auth
ADMIN_USER=
ADMIN_PASSWORD=

# SQLite Database path (defaults to ./data/tacit.db locally, /app/data/tacit.db in Docker)
DATABASE_PATH=

# Contact & Notification Email
CONTACT_EMAIL=YOUR_EMAIL
NOTIFY_EMAIL=

# Optional SMTP Settings for Form Submission Alerts (left empty to skip email notification)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Public Site URL for canonical links and Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000
