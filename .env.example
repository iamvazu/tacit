# Admin Credentials for /admin basic auth
ADMIN_USER=
ADMIN_PASSWORD=

# SQLite Database path (defaults to ./data/tacit.db locally, /app/data/tacit.db in Docker)
DATABASE_PATH=

# Contact & Notification Email
CONTACT_EMAIL=hello@tacit.exchange
NOTIFY_EMAIL=iamvazu@gmail.com, hello@tacit.exchange

# Hostinger SMTP Settings for Form Submission Alerts and User Confirmations
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=hello@tacit.exchange
SMTP_PASS=
SMTP_FROM="Tacit" <hello@tacit.exchange>

# Public Site URL for canonical links and Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000
